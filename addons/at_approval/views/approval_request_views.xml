<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="at_approval_request_view_form" model="ir.ui.view">
        <field name="name">at.approval.request.form</field>
        <field name="model">at.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft' or not can_manage"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="not can_approve"/>
                    <button name="action_refuse" string="Refuse" type="object" invisible="not can_approve"/>
                    <button name="action_return" string="Return for Revision" type="object" invisible="not can_approve"/>
                    <button name="action_withdraw" string="Withdraw My Decision" type="object" invisible="not can_withdraw"/>
                    <button name="action_force_approve" string="Force Approval" type="object"
                            groups="at_approval.group_approval_officer" invisible="state != 'pending'"
                            confirm="Approve this request on behalf of every remaining approver?"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'pending') or not can_manage"/>
                    <button name="action_draft" string="Back to Draft" type="object" invisible="state not in ('cancel', 'refused') or not can_manage"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <field name="can_approve" invisible="1"/>
                    <field name="can_withdraw" invisible="1"/>
                    <field name="can_manage" invisible="1"/>
                    <field name="has_document" invisible="1"/>
                    <field name="has_partner" invisible="1"/>
                    <field name="has_date" invisible="1"/>
                    <field name="has_period" invisible="1"/>
                    <field name="has_product" invisible="1"/>
                    <field name="has_quantity" invisible="1"/>
                    <field name="has_amount" invisible="1"/>
                    <field name="has_reference" invisible="1"/>
                    <field name="has_location" invisible="1"/>
                    <field name="has_employee" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <field name="code" class="text-muted" invisible="not code"/>
                        <h1><field name="name" placeholder="Subject" readonly="state != 'draft'"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not return_reason or state != 'draft'">
                        <b>Revision requested:</b> <field name="return_reason" nolabel="1"/>
                    </div>
                    <group>
                        <group name="who">
                            <field name="category_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                            <field name="request_owner_id" readonly="state != 'draft'" widget="many2one_avatar_user"/>
                            <field name="employee_id" readonly="state != 'draft'"
                                   invisible="has_employee == 'no'" required="has_employee == 'required'"/>
                            <field name="partner_id" readonly="state != 'draft'"
                                   invisible="has_partner == 'no'" required="has_partner == 'required'"/>
                            <field name="reference" readonly="state != 'draft'"
                                   invisible="has_reference == 'no'" required="has_reference == 'required'"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                        </group>
                        <group name="what">
                            <field name="date" readonly="state != 'draft'"
                                   invisible="has_date == 'no'" required="has_date == 'required'"/>
                            <field name="date_start" string="Period" widget="daterange" options="{'end_date_field': 'date_end'}"
                                   readonly="state != 'draft'"
                                   invisible="has_period == 'no'" required="has_period == 'required'"/>
                            <field name="date_end" invisible="1"/>
                            <field name="location" readonly="state != 'draft'"
                                   invisible="has_location == 'no'" required="has_location == 'required'"/>
                            <field name="amount" readonly="state != 'draft'"
                                   invisible="has_amount == 'no'" required="has_amount == 'required'"/>
                            <field name="quantity" readonly="state != 'draft'"
                                   invisible="has_quantity == 'no'" required="has_quantity == 'required'"/>
                        </group>
                    </group>
                    <field name="request_properties" columns="2" readonly="state != 'draft'"/>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" readonly="state != 'draft'" placeholder="Describe the request..."/>
                        </page>
                        <page string="Products" name="products" invisible="has_product == 'no'">
                            <field name="product_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approvers" name="approvers">
                            <div invisible="state != 'draft'">
                                <label for="approver_preview" string="Expected approvers when you submit"/>
                                <field name="approver_preview"/>
                                <div class="text-muted mb-2">You can add more approvers below. They approve after the steps above.</div>
                            </div>
                            <field name="approver_ids" readonly="state not in ('draft', 'pending')">
                                <list editable="bottom" decoration-muted="status in ('cancel', 'waiting')">
                                    <field name="step_id" optional="show"/>
                                    <field name="user_id" widget="many2one_avatar_user" readonly="step_id"/>
                                    <field name="required" optional="show"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'approved'"
                                           decoration-danger="status == 'refused'"
                                           decoration-warning="status == 'pending'"
                                           decoration-info="status == 'waiting'"/>
                                    <field name="decided_on" optional="show"/>
                                    <field name="comment" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter open_attachments="True" reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="at_approval_request_view_list" model="ir.ui.view">
        <field name="name">at.approval.request.list</field>
        <field name="model">at.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" decoration-muted="state == 'cancel'">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="request_owner_id" widget="many2one_avatar_user"/>
                <field name="employee_id" optional="hide"/>
                <field name="amount" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="create_date" string="Created On" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="at_approval_request_view_kanban" model="ir.ui.view">
        <field name="name">at.approval.request.kanban</field>
        <field name="model">at.approval.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="0" group_delete="0" records_draggable="0">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="code" class="text-muted small"/>
                        <field name="category_id" class="text-muted"/>
                        <footer>
                            <field name="create_date" widget="date" class="text-muted small"/>
                            <field name="request_owner_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="at_approval_request_view_calendar" model="ir.ui.view">
        <field name="name">at.approval.request.calendar</field>
        <field name="model">at.approval.request</field>
        <field name="arch" type="xml">
            <calendar string="Approval Requests" date_start="date_start" date_stop="date_end" color="category_id" mode="month">
                <field name="category_id" filters="1"/>
                <field name="request_owner_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="at_approval_request_view_search" model="ir.ui.view">
        <field name="name">at.approval.request.search</field>
        <field name="model">at.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="category_id"/>
                <field name="request_owner_id"/>
                <field name="employee_id"/>
                <filter name="my_requests" string="My Requests" domain="[('request_owner_id', '=', uid)]"/>
                <filter name="to_review" string="Waiting for My Approval"
                        domain="[('approver_ids', 'any', [('user_id', '=', uid), ('status', '=', 'pending')])]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="pending" string="Submitted" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="refused" string="Refused" domain="[('state', '=', 'refused')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_owner" string="Requested By" context="{'group_by': 'request_owner_id'}"/>
                    <filter name="group_category" string="Approval Type" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_request_my" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">at.approval.request</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="domain">[('request_owner_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No request yet</p>
            <p>Create one from the Approvals dashboard.</p>
        </field>
    </record>

    <record id="action_request_to_review" model="ir.actions.act_window">
        <field name="name">To Review</field>
        <field name="res_model">at.approval.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('approver_ids', 'any', [('user_id', '=', uid), ('status', '=', 'pending')])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is waiting for your approval</p>
        </field>
    </record>

    <record id="action_request_all" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">at.approval.request</field>
        <field name="view_mode">list,kanban,calendar,form</field>
    </record>

</odoo>
