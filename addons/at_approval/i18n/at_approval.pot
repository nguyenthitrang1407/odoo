#. module: at_approval
#: model:mail.template,body_html:at_approval.mail_template_approved
msgid ""
"<div style=\"font-size: 13px; margin: 0px; padding: 0px;\">\n"
"    <p>Hello <t t-out=\"object.request_owner_id.name or ''\">Owner</t>,</p>\n"
"    <p>Your request <b t-out=\"object.name or ''\">Request</b> has been approved.</p>\n"
"    <p>\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=at.approval.request&amp;res_id={{ object.id }}\" style=\"background-color: #714B67; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;\">View Request</a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

#. module: at_approval
#: model:mail.template,body_html:at_approval.mail_template_refused
msgid ""
"<div style=\"font-size: 13px; margin: 0px; padding: 0px;\">\n"
"    <p>Hello <t t-out=\"object.request_owner_id.name or ''\">Owner</t>,</p>\n"
"    <p>Your request <b t-out=\"object.name or ''\">Request</b> has been refused.</p>\n"
"    <p>\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=at.approval.request&amp;res_id={{ object.id }}\" style=\"background-color: #714B67; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;\">View Request</a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

#. module: at_approval
#: model:mail.template,body_html:at_approval.mail_template_returned
msgid ""
"<div style=\"font-size: 13px; margin: 0px; padding: 0px;\">\n"
"    <p>Hello <t t-out=\"object.request_owner_id.name or ''\">Owner</t>,</p>\n"
"    <p>Your request <b t-out=\"object.name or ''\">Request</b> was returned to you for revision.</p>\n"
"    <p t-if=\"not object.is_confidential and object.return_reason\">Reason: <t t-out=\"object.return_reason or ''\">Reason</t></p>\n"
"    <p>\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=at.approval.request&amp;res_id={{ object.id }}\" style=\"background-color: #714B67; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;\">View Request</a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

#. module: at_approval
#: model:mail.template,body_html:at_approval.mail_template_request
msgid ""
"<div style=\"font-size: 13px; margin: 0px; padding: 0px;\">\n"
"    <p>Hello <t t-out=\"object.user_id.name or ''\">Approver</t>,</p>\n"
"    <p>The request <b t-out=\"object.request_id.name or ''\">Request</b> is waiting for your approval.</p>\n"
"    <ul t-if=\"not object.request_id.is_confidential\">\n"
"        <li>Type: <t t-out=\"object.request_id.category_id.name or ''\">Type</t></li>\n"
"        <li>Requested by: <t t-out=\"object.request_id.request_owner_id.name or ''\">Owner</t></li>\n"
"        <li t-if=\"object.request_id.employee_id\">Employee concerned: <t t-out=\"object.request_id.employee_id.name or ''\">Employee</t></li>\n"
"        <li t-if=\"object.request_id.amount\">Amount: <t t-out=\"format_amount(object.request_id.amount, object.request_id.currency_id) or ''\">0</t></li>\n"
"        <li t-if=\"object.step_id\">Step: <t t-out=\"object.step_id.name or ''\">Step</t></li>\n"
"    </ul>\n"
"    <p>\n"
"        <a t-attf-href=\"{{ object.request_id.get_base_url() }}/mail/view?model=at.approval.request&amp;res_id={{ object.request_id.id }}\" style=\"background-color: #714B67; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;\">View Request</a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

